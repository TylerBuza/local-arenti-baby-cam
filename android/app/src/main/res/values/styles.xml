<resources>
    <style name="BaseAppTheme" parent="Theme.AppCompat.DayNight.NoActionBar">
        <item name="colorAccent">@color/buza_accent</item>
        <item name="colorControlNormal">@color/buza_muted</item>
        <item name="colorControlActivated">@color/buza_accent</item>
        <item name="android:windowLightStatusBar">false</item>
        <item name="android:windowBackground">@color/buza_background</item>
        <item name="android:statusBarColor">@color/buza_background</item>
        <item name="android:navigationBarColor">@color/buza_background</item>
        <item name="android:fontFamily">sans-serif</item>
        <item name="android:colorBackground">@color/buza_background</item>
        <item name="android:textColorPrimary">@color/buza_ink</item>
        <item name="android:textColorSecondary">@color/buza_muted</item>
        <item name="buttonStyle">@style/BuzaButton</item>
    </style>
    <style name="AppTheme" parent="BaseAppTheme" />
    <style name="BuzaButton" parent="Widget.AppCompat.Button">
        <item name="android:background">@drawable/bg_button</item>
        <item name="backgroundTint">@null</item>
        <item name="android:backgroundTint">@null</item>
        <item name="android:textColor">@color/button_text</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:textAllCaps">false</item>
        <item name="android:textSize">14sp</item>
        <item name="android:letterSpacing">0</item>
        <item name="android:minWidth">0dp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:paddingStart">10dp</item>
        <item name="android:paddingEnd">10dp</item>
        <item name="android:paddingTop">8dp</item>
        <item name="android:paddingBottom">8dp</item>
        <item name="android:stateListAnimator">@null</item>
        <item name="android:maxLines">2</item>
    </style>
    <style name="BuzaPrimaryButton" parent="BuzaButton">
        <item name="android:background">@drawable/bg_primary</item>
        <item name="android:textColor">@color/buza_dark_ink</item>
    </style>
    <style name="BuzaToolButton" parent="BuzaButton">
        <item name="android:background">@drawable/bg_tool</item>
        <item name="android:textSize">12sp</item>
        <item name="android:minHeight">48dp</item>
        <item name="android:drawablePadding">5dp</item>
        <item name="android:paddingStart">3dp</item>
        <item name="android:paddingEnd">3dp</item>
    </style>
    <style name="BuzaEyebrow">
        <item name="android:textColor">@color/buza_accent</item>
        <item name="android:textSize">10sp</item>
        <item name="android:fontFamily">sans-serif-medium</item>
        <item name="android:letterSpacing">0.16</item>
    </style>
</resources>
