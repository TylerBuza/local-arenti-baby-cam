<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto" android:id="@+id/root"
    android:layout_width="match_parent" android:layout_height="match_parent"
    android:orientation="vertical" android:padding="16dp" android:background="@color/buza_background">
    <LinearLayout android:id="@+id/header" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:paddingBottom="16dp">
        <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center_vertical">
            <ImageView android:layout_width="44dp" android:layout_height="44dp" android:padding="10dp" android:background="@drawable/bg_logo" android:src="@drawable/ic_camera" android:importantForAccessibility="no" />
            <LinearLayout android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:orientation="vertical" android:layout_marginStart="12dp">
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:text="Local" android:textColor="@color/buza_ink" android:textSize="23sp" android:fontFamily="sans-serif-medium" />
                <TextView style="@style/BuzaEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="BABY CAM" />
            </LinearLayout>
            <Button android:id="@+id/pair" android:layout_width="wrap_content" android:layout_height="wrap_content" android:text="Connection" />
        </LinearLayout>
        <TextView android:id="@+id/camera_heading" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="18dp"
            android:text="Camera" android:textColor="@color/buza_ink" android:textSize="28sp" android:fontFamily="sans-serif-medium" />
        <TextView android:id="@+id/route" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp"
            android:text="Not connected" android:textColor="@color/buza_muted" android:textSize="13sp" />
    </LinearLayout>
    <FrameLayout android:id="@+id/video_frame" android:layout_width="match_parent" android:layout_height="0dp" android:layout_weight="1"
        android:background="@drawable/bg_video" android:clipChildren="true">
        <dev.tvmodding.privatecamera.ZoomPlayerView android:id="@+id/video" android:layout_width="match_parent"
            android:layout_height="match_parent" app:use_controller="false" app:surface_type="texture_view" app:resize_mode="fit" app:shutter_background_color="#101D28"
            android:contentDescription="Camera video. Pinch to zoom, drag to pan, double-tap to reset." />
        <TextView android:id="@+id/clock" android:layout_width="wrap_content" android:layout_height="wrap_content"
            android:textColor="@color/buza_ink" android:textSize="12sp" android:fontFamily="sans-serif-medium" android:paddingHorizontal="9dp" android:paddingVertical="6dp"
            android:background="@drawable/bg_glass" android:visibility="gone" android:contentDescription="Phone date and time" />
        <TextView android:id="@+id/status" android:layout_width="wrap_content" android:layout_height="wrap_content" android:layout_margin="24dp"
            android:layout_gravity="center" android:text="Not connected" android:textColor="@color/buza_muted" android:textSize="14sp" android:padding="8dp"
            android:gravity="center" />
        <TextView android:id="@+id/sock_readings" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:layout_gravity="bottom" android:layout_margin="8dp" android:paddingHorizontal="8dp" android:paddingVertical="5dp"
            android:textColor="@color/buza_ink" android:textSize="12sp" android:background="@drawable/bg_glass"
            android:gravity="center" android:visibility="gone" android:importantForAccessibility="yes" />
    </FrameLayout>
    <dev.tvmodding.privatecamera.ControlScrollView android:id="@+id/control_scroll" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:fillViewport="false" android:scrollbars="vertical">
    <LinearLayout android:id="@+id/control_dock" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
        <LinearLayout android:id="@+id/video_controls" android:layout_width="match_parent" android:layout_height="wrap_content"
            android:orientation="vertical" android:padding="8dp" android:background="@drawable/bg_card">
            <TextView android:id="@+id/control_heading" style="@style/BuzaEyebrow" android:layout_width="match_parent" android:layout_height="wrap_content" android:text="CAMERA CONTROLS" android:layout_marginBottom="12dp" />
            <LinearLayout android:id="@+id/move_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical" android:visibility="gone" android:paddingBottom="12dp">
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                    <Button android:id="@+id/up" android:layout_width="76dp" android:layout_height="48dp" android:minHeight="48dp" android:text="↑" android:textSize="22sp" android:contentDescription="Move camera up" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center" android:layout_marginVertical="5dp">
                    <Button android:id="@+id/left" android:layout_width="76dp" android:layout_height="48dp" android:minHeight="48dp" android:text="←" android:textSize="22sp" android:contentDescription="Move camera left" />
                    <Button android:id="@+id/ptz_stop" android:layout_width="76dp" android:layout_height="48dp" android:minHeight="48dp" android:layout_marginHorizontal="5dp" android:text="Stop" android:contentDescription="Stop camera movement" />
                    <Button android:id="@+id/right" android:layout_width="76dp" android:layout_height="48dp" android:minHeight="48dp" android:text="→" android:textSize="22sp" android:contentDescription="Move camera right" />
                </LinearLayout>
                <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:gravity="center">
                    <Button android:id="@+id/down" android:layout_width="76dp" android:layout_height="48dp" android:minHeight="48dp" android:text="↓" android:textSize="22sp" android:contentDescription="Move camera down" />
                </LinearLayout>
                <TextView android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:text="Hold to move · release to stop" android:textSize="12sp" android:textColor="@color/buza_muted" android:gravity="center" />
            </LinearLayout>
            <LinearLayout android:id="@+id/playback_panel" android:layout_width="match_parent" android:layout_height="wrap_content" android:orientation="vertical">
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:baselineAligned="false">
                <Button android:id="@+id/start" style="@style/BuzaPrimaryButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Start" />
                <Button android:id="@+id/stop" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:layout_marginHorizontal="8dp" android:text="Stop" />
                <Button android:id="@+id/mute" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Muted" />
            </LinearLayout>
            <LinearLayout android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="4dp" android:baselineAligned="false">
                <Spinner android:id="@+id/quality" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:minHeight="48dp" android:background="@drawable/bg_tool" android:popupBackground="@drawable/bg_card" android:dropDownWidth="160dp" android:contentDescription="Video quality" />
                <Button android:id="@+id/move_toggle" style="@style/BuzaToolButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Move" />
                <Button android:id="@+id/fullscreen" style="@style/BuzaToolButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="Full screen" />
                <Button android:id="@+id/pip" style="@style/BuzaToolButton" android:layout_width="0dp" android:layout_weight="1" android:layout_height="wrap_content" android:text="PiP" android:contentDescription="Picture in picture" />
            </LinearLayout>
            <TextView android:id="@+id/gesture_hint" android:layout_width="match_parent" android:layout_height="wrap_content" android:layout_marginTop="8dp" android:gravity="center" android:text="Pinch to zoom · double-tap to reset" android:textColor="@color/buza_muted" android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>
    </dev.tvmodding.privatecamera.ControlScrollView>
</LinearLayout>
